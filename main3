# Журнал файлының көлем шегі, жедел жадтағы оқиғалар саны және нәтижені көрсету уақыты.
LOG_FILE = "access_log.txt"
LOG_MAX_BYTES = 30000
LOG_KEEP_IN_RAM = 100
RESULT_SHOW_MIN_S = 3           


def now_str():
    # Жыл 2024-тен ерте болса, құрылғы іске қосылғалы өткен секундтарды көрсетеміз.
    t = time.time()
    if time.localtime(t)[0] >= 2024:            
        y, mo, d, h, mi, s = time.localtime(t + TZ_OFFSET_H * 3600)[:6]
        return "%04d-%02d-%02d %02d:%02d:%02d" % (y, mo, d, h, mi, s)
    return "T+%ds" % (time.ticks_ms() // 1000)


# Аты-жөнді OLED дисплейіне шығару үшін кирилл әріптерін латыншаға ауыстыру кестесі.
_TR = {
    'а': 'a', 'б': 'b', 'в': 'v', 'г': 'g', 'д': 'd', 'е': 'e', 'ё': 'e', 'ж': 'zh',
    'з': 'z', 'и': 'i', 'й': 'y', 'к': 'k', 'л': 'l', 'м': 'm', 'н': 'n', 'о': 'o',
    'п': 'p', 'р': 'r', 'с': 's', 'т': 't', 'у': 'u', 'ф': 'f', 'х': 'kh', 'ц': 'ts',
    'ч': 'ch', 'ш': 'sh', 'щ': 'shch', 'ъ': '', 'ы': 'y', 'ь': '', 'э': 'e', 'ю': 'yu',
    'я': 'ya', 'ә': 'a', 'ғ': 'g', 'қ': 'k', 'ң': 'n', 'ө': 'o', 'ұ': 'u', 'ү': 'u',
    'һ': 'h', 'і': 'i',
}


def translit(text):
    # Әріпті ауыстырғанда оның бас не кіші әріп екенін ескереміз.
    out = ""
    for ch in text:
        low = ch.lower()
        if low in _TR:
            t = _TR[low]
            out += t.capitalize() if ch != low else t
        else:
            out += ch
    return out


# Жедел жадтағы журнал және іске қосылғаннан бері тіркелген оқиғаның реттік нөмірі.
access_log = []
_seq = 0


def log_event(uid, name, result, reason="", count=None):
    global _seq
    _seq += 1
    ev = {
        "n": _seq,
        "time": now_str(),
        "uid": uid,
        "name": name,
        "result": result,         
        "reason": reason,
        "count": count,
    }
    # Жедел жадтағы журнал шегіне жеткенде ең ескі жазбаны өшіреміз.
    access_log.append(ev)
    if len(access_log) > LOG_KEEP_IN_RAM:
        access_log.pop(0)
    print("СОБЫТИЕ:", ev)
    try:
        # Файл көлемі шектен асса, жаңа жазба алдында оны .old атауымен сақтаймыз.
        if LOG_FILE in os.listdir() and os.stat(LOG_FILE)[6] > LOG_MAX_BYTES:
            try:
                os.remove(LOG_FILE + ".old")
            except OSError:
                pass
            os.rename(LOG_FILE, LOG_FILE + ".old")
        with open(LOG_FILE, "a") as f:
            f.write(json.dumps(ev) + "\n")
    except Exception as e:
        print("log file error:", e)
    return ev


# 128×64 OLED дисплейін бағдарламалық I²C шинасы арқылы іске қосамыз.
oled = None
if ssd1306:
    try:
        _i2c = SoftI2C(scl=Pin(OLED_SCL), sda=Pin(OLED_SDA), freq=400000)
        oled = ssd1306.SSD1306_I2C(128, 64, _i2c, OLED_ADDR)
    except Exception as e:
        print("OLED не найден:", e)
        oled = None


def show(*lines):
    """До 6 строк по 16 символов. Только латиница (шрифт OLED)."""
    # Дисплей болмаса да, хабарларды консольге шығарамыз.
    for ln in lines:
        print("OLED |", ln)
    if not oled:
        return
    try:
        oled.fill(0)
        for i, ln in enumerate(lines[:6]):
            oled.text(str(ln)[:16], 0, i * 10)
        oled.show()
    except Exception as e:
        print("OLED error:", e)


def name_lines(name):
    # Экранға әрқайсысы 16 таңбадан тұратын екі жолға дейін шығарамыз.
    t = translit(name)
    return [t[:16], t[16:32]] if len(t) > 16 else [t]


# Wi-Fi клиент режимінде жұмыс істейді.
wlan = network.WLAN(network.STA_IF)


def wifi_connect(timeout=10):
    wlan.active(True)
    if wlan.isconnected():
        return True
    try:
        wlan.connect(WIFI_SSID, WIFI_PASS)
    except Exception as e:
        print("wifi error:", e)
        return False
    # Күту уақыты біткенше қосылымды әр 200 мс сайын тексереміз.
    t0 = time.ticks_ms()
    while not wlan.isconnected():
        if time.ticks_diff(time.ticks_ms(), t0) > timeout * 1000:
            print("WIFI_FAIL")
            return False
        time.sleep_ms(200)
    print("WIFI_OK", wlan.ifconfig()[0])
    return True


def sync_time():
    # Уақытты синхрондау үшін ntptime модулі мен Wi-Fi қосылымы қажет.
    if ntptime and wlan.isconnected():
        try:
            ntptime.settime()
            print("NTP_OK")
        except Exception as e:
            print("NTP_FAIL", e)


def _uid_for_api(uid):
    # UID жасыру қосылса, тек соңғы екі байтын көрсетеміз.
    if MASK_UID_IN_API:
        return "**:**:" + uid[-5:]
    return uid


def build_payload(current):
    """Сводка журнала для API. Состав полей — УТОЧНИТЬ по конкурсному заданию."""
    # Жедел жадтағы журналдан нәтижелерді және әр карта бойынша оқиғаларды санаймыз.
    granted = denied = errors = 0
    per_card = {}
    for e in access_log:
        if e["result"] == "GRANTED":
            granted += 1
        elif e["result"] == "DENIED":
            denied += 1
        else:
            errors += 1
        k = _uid_for_api(e["uid"])
        per_card[k] = per_card.get(k, 0) + 1
    # Сұрауға соңғы он жазбаға дейін қосамыз.
    last = []
    for e in access_log[-10:]:
        last.append({
            "n": e["n"], "time": e["time"], "uid": _uid_for_api(e["uid"]),
            "result": e["result"], "reason": e["reason"], "count": e["count"],
        })
    return {
        "device": "esp32-b2",
        "current": {
            "uid": _uid_for_api(current["uid"]),
            "result": current["result"],
            "reason": current["reason"],
            "count": current["count"],
        },
        "summary": {
            "total": len(access_log), "granted": granted,
            "denied": denied, "errors": errors, "per_card": per_card,
        },
        "events": last,
    }


def extract_risk(d):
    # Тәуекел бағасын алдымен белгілі кілттерден, кейін ішкі сөздіктерден іздейміз.
    if not isinstance(d, dict):
        return None
    for k in RISK_FIELDS:
        v = d.get(k)
        if isinstance(v, (int, float, str)) and not isinstance(v, bool):
            return v
    for v in d.values():
        if isinstance(v, dict):
            r = extract_risk(v)
            if r is not None:
                return r
    return None


def request_risk(current_event):
    """Возвращает оценку риска или None. Ошибка API НЕ влияет на решение о доступе."""
    if not API_URL:
        return None
    if not wlan.isconnected() and not wifi_connect(6):
        print("API: нет Wi-Fi")
        return None
    r = None
    try:
        # Жиынтықты JSON түрінде жібереміз, ал API кілті берілсе, оны HTTP тақырыбына қосамыз.
        body = json.dumps(build_payload(current_event))
        headers = {"Content-Type": "application/json"}
        if API_KEY:
            headers[API_KEY_HEADER] = API_KEY_PREFIX + API_KEY
        try:
            r = requests.post(API_URL, data=body, headers=headers, timeout=API_TIMEOUT_S)
        except TypeError:                       # старая прошивка без timeout
            r = requests.post(API_URL, data=body, headers=headers)
        if r.status_code not in (200, 201):
            print("API_FAIL status", r.status_code)
            return None
        risk = extract_risk(r.json())
        if risk is None:
            print("API_FAIL: поля риска нет в ответе")
        return risk
    except Exception as e:
        print("API_FAIL", e)
        return None
    finally:
        # Функциядан шығарда HTTP жауабын жабамыз.
        if r:
            try:
                r.close()
            except Exception:
                pass


# Картамен жұмыс істеу кезінде туындайтын қателерге арналған ерекше жағдай.
class CardError(Exception):
    pass


rdr = None


def uid_str(raw):
    # Тізімнен іздеу үшін UID-дің алғашқы төрт байтын мәтінге айналдырамыз.
    return ":".join("%02X" % b for b in raw[:4])


def read_uid():
    # Алдымен картаның бар-жоғын тексеріп, кейін UID мәнін оқимыз.
    stat, _ = rdr.request(rdr.REQIDL)
    if stat != rdr.OK:
        return None
    stat, raw = rdr.anticoll()
    if stat != rdr.OK:
        return None
    return raw


def halt_card():
    """Команда HLTA: карта «засыпает» и не отвечает, пока её не уберут."""
    try:
        buf = [0x50, 0x00]
        buf += rdr._crc(buf)
        rdr._tocard(0x0C, buf)
    except Exception:
        pass


def wait_card_removed():
    """Ждём, пока карту уберут из поля (3 подряд пустых опроса)."""
    absent = 0
    while absent < 3:
        # REQALL сұрауына HALT күйіндегі карталар да жауап береді.
        stat, _ = rdr.request(rdr.REQALL)       
        if stat == rdr.OK:
            absent = 0
            s, raw = rdr.anticoll()
            if s == rdr.OK and rdr.select_tag(raw) == rdr.OK:
                halt_card()
        else:
            absent += 1
        time.sleep_ms(80)


def _check_block(addr):
    
    # Аты-жөн мен санауыш блоктарына ғана рұқсат береміз. Қызметтік блоктар қолданылмайды.
    allowed = tuple(NAME_BLOCKS) + (COUNTER_BLOCK,)
    if addr not in allowed or addr == 0 or addr % 4 == 3:
        raise CardError("block %d запрещён" % addr)


def read_block(addr):
    # Блоктан дәл 16 байт қайтарамыз.
    _check_block(addr)
    d = rdr.read(addr)
    if d is None or len(d) < 16:
        raise CardError("read %d fail" % addr)
    return bytes(d[:16])


def write_block(addr, data):
    # Жазу алдында блок мекенжайын, жазудан кейін нәтиже күйін тексереміз.
    _check_block(addr)
    if rdr.write(addr, list(data)) != rdr.OK:
        raise CardError("write %d fail" % addr)


def fit_name(name):
    # UTF-8 пішіміндегі аты-жөн 32 байтқа сыйғанша соңғы таңбаларын алып тастаймыз.
    while len(name.encode()) > 32:
        name = name[:-1]
    return name


def read_card_data():
    # Аты-жөнді екі блоктан құрап, соңындағы нөлдік байттарды алып тастаймыз.
    nb = read_block(NAME_BLOCKS[0]) + read_block(NAME_BLOCKS[1])
    try:
        name = nb.rstrip(b"\x00").decode()
    except Exception:
        name = ""
    # Белгі табылса, одан кейінгі төрт байттан санауышты оқимыз.
    cb = read_block(COUNTER_BLOCK)
    count = int.from_bytes(cb[1:5], "big") if cb[0] == CARD_MAGIC else 0
    return name, count


def write_card_data(name, count):
    # Аты-жөнді нөлдік байттармен толықтырып, 16 байттан екі блокқа бөлеміз.
    nb = fit_name(name).encode()
    nb = nb + b"\x00" * (32 - len(nb))
    write_block(NAME_BLOCKS[0], nb[:16])
    write_block(NAME_BLOCKS[1], nb[16:])
    # Санауыш блогына белгі, санның төрт байты және 11 нөлдік байт жазамыз.
    write_block(COUNTER_BLOCK, bytes([CARD_MAGIC]) + count.to_bytes(4, "big") + bytes(11))


def card_update(raw, name):
    """Аутентификация -> чтение -> +1 к счётчику -> запись -> проверка. Возвращает новый счётчик."""
    if rdr.select_tag(raw) != rdr.OK:
        raise CardError("select fail")
    try:
        if rdr.auth(rdr.AUTHENT1A, COUNTER_BLOCK, KEY_A, raw) != rdr.OK:
            raise CardError("auth fail")
        _, old_count = read_card_data()
        new_count = old_count + 1
        write_card_data(name, new_count)
        # Екі өрістің де дұрыс жазылғанын тексеру үшін картаны қайта оқимыз.
        chk_name, chk_count = read_card_data()
        if chk_name != fit_name(name) or chk_count != new_count:
            raise CardError("verify fail")
        return new_count
    finally:
        rdr.stop_crypto1()


def process_card(raw):
    uid = uid_str(raw)
    print("Card detected, UID:", uid)
    emp = employees.get(uid)

    # Белгісіз немесе белсенді емес карталарға өтуге рұқсат бермейміз.
    if emp is None:
        log_event(uid, "UNKNOWN", "DENIED", "card not registered")
        show("ACCESS DENIED", "Card not found", "UID:", uid)
        print("Неизвестная карта. Чтобы добавить, внеси UID в employees:", uid)
        return

    if not emp.get("active", False):
        log_event(uid, emp["name"], "DENIED", "card inactive")
        show("ACCESS DENIED", "Card inactive", *name_lines(emp["name"]))
        return

    # Белсенді картадағы аты-жөн мен өту санауышын жаңартамыз.
    name = emp["name"]
    try:
        count = card_update(raw, name)
    except CardError as e:
        log_event(uid, name, "ERROR", "card: %s" % e)
        show("CARD ERROR", str(e), "Data not", "confirmed")
        return

    # Рұқсатты журналға жазып, экранға шығару үшін тәуекел бағасын сұраймыз.
    ev = log_event(uid, name, "GRANTED", "", count)
    show("ACCESS GRANTED", "Checking risk...", *name_lines(name))
    risk = request_risk(ev)
    risk_txt = "Risk: " + str(risk) if risk is not None else "Risk: N/A"
    lines = ["ACCESS GRANTED"] + name_lines(name) + ["Passes: %d" % count, risk_txt]
    if risk is None:
        lines.append("(risk unavailable)")
    show(*lines)


def idle_screen():
    # Күту экранында Wi-Fi күйі мен жедел жадтағы оқиғалар саны көрсетіледі.
    show("B2 RFID ACCESS", "Present card...", "",
         "WiFi: " + ("OK" if wlan.isconnected() else "--"),
         "Events: %d" % len(access_log))


def main():
    global rdr
    show("B2 RFID ACCESS", "Starting...")

    # Оқырманмен байланысты тексеру үшін RC522 нұсқа регистрін оқимыз.
    try:
        rdr = MFRC522(RFID_SCK, RFID_MOSI, RFID_MISO, RFID_RST, RFID_CS)
        ver = rdr._rreg(0x37)                    
        print("RFID reader initialized, version 0x%02X" % ver)
        if ver in (0x00, 0xFF):
            show("RFID ERROR", "Reader no reply", "Check SPI/CS/RST", "and power")
            raise RuntimeError("RC522 не отвечает (version=0x%02X)" % ver)
    except RuntimeError:
        raise
    except Exception as e:
        show("RFID ERROR", str(e))
        raise

    show("Wi-Fi...", WIFI_SSID)
    if wifi_connect():
        sync_time()

    idle_screen()
    result_at = None

    # Бір картаны қайта өңдемеу үшін оны оқырманнан алыстатқанша күтеміз.
    while True:
        try:
            raw = read_uid()
            if raw:
                process_card(raw)
                result_at = time.ticks_ms()
                halt_card()
                wait_card_removed()              
                
                # Күту экранына оралмас бұрын нәтижені кемінде белгіленген уақыт көрсетеміз.
                while time.ticks_diff(time.ticks_ms(), result_at) < RESULT_SHOW_MIN_S * 1000:
                    time.sleep_ms(100)
                idle_screen()
                time.sleep_ms(300)
            else:
                time.sleep_ms(100)
        except KeyboardInterrupt:
            raise
        except Exception as e:
            # Жүйелік қатені журналға тіркеп, карталарды тексеруді жалғастырамыз.
            print("SYSTEM_ERROR:", repr(e))
            try:
                log_event("-", "-", "ERROR", "system: %s" % e)
                show("SYSTEM ERROR", str(e))
                time.sleep(2)
                idle_screen()
            except Exception:
                pass


main()

