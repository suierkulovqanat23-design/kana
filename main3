

import time
from machine import ADC, Pin
from neopixel import NeoPixel


# 1. Баптаулар

# Бұл GPIO нөмірлері оқу үлгісінен алынған. Стенд сұлбасымен салыстырыңыз.
MQ2_ADC_PIN = 34
WS2812_PIN = 18
LED_COUNT = 1

# Уақыт пен резервтік шекті тапсырмада берілген мәндерге ауыстырыңыз.
# Шек пен өлшемдер АЦТ бірлігімен беріледі.
WARMUP_S = 60
DEFAULT_THRESHOLD = 2500
ADC_MAX = 4095

CALIBRATION_SAMPLES = 25
CALIBRATION_INTERVAL_MS = 200
FILTER_SAMPLES = 9
FILTER_INTERVAL_MS = 50
MONITOR_INTERVAL_MS = 1000

# API_URL бос қалса, бағдарлама бірден резервтік шекті қолданады.
WIFI_SSID = ""
WIFI_PASSWORD = ""
WIFI_TIMEOUT_MS = 10000

# Өріс атаулары мен HTTP тақырыбын API сипаттамасына сай өзгертіңіз.
API_URL = ""
API_KEY = ""
API_KEY_HEADER = "X-API-Key"
API_KEY_PREFIX = ""
API_BASELINE_FIELD = "baseline"
API_THRESHOLD_FIELD = "threshold"
API_TIMEOUT_S = 5

# WS2812 түстері RGB ретімен берілген.
STATUS_COLORS = {
    "WARMUP": (0, 0, 80),         # Көк — датчик қызуда
    "CALIBRATION": (80, 50, 0),   # Сары — фон өлшеніп жатыр
    "NORMAL": (0, 100, 0),       # Жасыл — қалыпты күй
    "ALARM": (100, 0, 0),        # Қызыл — дабыл
    "ERROR": (80, 0, 80),         # Күлгін — қате
}

STATE_NAMES = {
    "NORMAL": "ҚАЛЫПТЫ",
    "ALARM": "ДАБЫЛ",
    "ERROR": "ҚАТЕ",
}


# 2. Жарық индикациясы және өлшеу

def show_status(pixels, status):
    # Барлық жарықдиодқа бір түсті орнатып, деректі жолаққа жібереміз.
    pixels.fill(STATUS_COLORS[status])
    pixels.write()


def read_gas(adc):
    # MQ-2 датчигінің аналогтық шығысынан 12 биттік мәнді оқимыз.
    return adc.read()


def median(values):
    # Медиана бір реттік секірулердің нәтижеге әсерін азайтады.
    ordered = sorted(values)
    return ordered[len(ordered) // 2]


def calibrate(adc):
    # Қыздыру аяқталған соң бөлменің қалыпты жағдайында фонды өлшейміз.
    background = []
    for index in range(CALIBRATION_SAMPLES):
        value = read_gas(adc)
        background.append(value)
        print("Фондық өлшем %d: %d" % (index + 1, value))
        time.sleep_ms(CALIBRATION_INTERVAL_MS)

    return median(background)


def filtered_read(adc):
    # Алғашқы мән журналға жазылады және сүзгіге де беріледі.
    raw = read_gas(adc)
    samples = [raw]
    for _ in range(FILTER_SAMPLES - 1):
        time.sleep_ms(FILTER_INTERVAL_MS)
        samples.append(read_gas(adc))

    return raw, median(samples)


# 3. Wi-Fi және API арқылы дабыл шегін алу

def wifi_connect():
    import network

    wlan = network.WLAN(network.STA_IF)
    wlan.active(True)

    if wlan.isconnected():
        return True

    wlan.connect(WIFI_SSID, WIFI_PASSWORD)
    started_at = time.ticks_ms()
    while not wlan.isconnected():
        # Wi-Fi қосылмаса, шексіз күтпейміз.
        elapsed = time.ticks_diff(time.ticks_ms(), started_at)
        if elapsed >= WIFI_TIMEOUT_MS:
            return False
        time.sleep_ms(200)

    return True


def valid_threshold(value):
    # Жауаптағы шек сан болуы және АЦТ диапазонына сыйуы керек.
    return (
        type(value) in (int, float)
        and 1 <= value <= ADC_MAX
    )


def get_threshold_from_api(baseline):
    if not API_URL:
        return None

    response = None
    try:
        # HTTP кітапханасы тек API бапталған кезде қажет.
        try:
            import urequests as requests
        except ImportError:
            import requests

        if not wifi_connect():
            print("Wi-Fi қосылмады. Резервтік шек қолданылады.")
            return None

        import json

        headers = {"Content-Type": "application/json"}
        if API_KEY:
            headers[API_KEY_HEADER] = API_KEY_PREFIX + API_KEY

        # Баптаудағы өріс арқылы фондық деңгейді JSON түрінде жібереміз.
        payload = {API_BASELINE_FIELD: baseline}
        response = requests.post(
            API_URL,
            data=json.dumps(payload),
            headers=headers,
            timeout=API_TIMEOUT_S,
        )

        if not 200 <= response.status_code < 300:
            print("API HTTP қатесі:", response.status_code)
            return None

        answer = response.json()
        threshold = answer.get(API_THRESHOLD_FIELD) if isinstance(answer, dict) else None
        if not valid_threshold(threshold):
            print("API жауабындағы дабыл шегі жарамсыз.")
            return None

        return threshold

    except Exception as error:
        print("API қатесі:", error)
        return None

    finally:
        # Сұрау сәтсіз аяқталса да, ашылған HTTP жауабын жабамыз.
        if response is not None:
            try:
                response.close()
            except Exception as error:
                print("HTTP жауабын жабу қатесі:", error)


# 4. Өлшеу журналы және негізгі бағдарлама

def log_measurement(number, raw, filtered, baseline, threshold, source, state):
    # Әр циклдің нәтижесі Thonny Shell терезесінде бір жолға шығады.
    print(
        "№%d | MQ-2: %s | Сүзгі: %s | Фон: %s | Шек: %s | "
        "Көзі: %s | Күйі: %s"
        % (number, raw, filtered, baseline, threshold, source, STATE_NAMES[state])
    )


def main():
    pixels = NeoPixel(Pin(WS2812_PIN, Pin.OUT), LED_COUNT)

    try:
        # ESP32-нің аналогтық кірісін 12 биттік режимге баптаймыз.
        adc = ADC(Pin(MQ2_ADC_PIN))
        adc.width(ADC.WIDTH_12BIT)
        adc.atten(ADC.ATTN_11DB)

        show_status(pixels, "WARMUP")
        print("MQ-2 қыздырылып жатыр. Күту уақыты: %d с." % WARMUP_S)
        time.sleep(WARMUP_S)

        show_status(pixels, "CALIBRATION")
        print("Фондық өлшемдер жиналып жатыр.")
        baseline = calibrate(adc)
        print("Фондық деңгей:", baseline)

        # API жарамды шек бермесе, жергілікті резервтік мәнді аламыз.
        threshold = get_threshold_from_api(baseline)
        source = "API"
        if threshold is None:
            threshold = DEFAULT_THRESHOLD
            source = "DEFAULT"

        print("Дабыл шегі: %s | Көзі: %s" % (threshold, source))

    except Exception as error:
        show_status(pixels, "ERROR")
        print("Іске қосу қатесі:", error)
        return

    number = 0
    while True:
        number += 1
        raw = "-"
        filtered = "-"

        try:
            raw, filtered = filtered_read(adc)

            # Сүзілген мән шектен асқанда қызыл дабыл жанады.
            state = "ALARM" if filtered > threshold else "NORMAL"
            show_status(pixels, state)

        except Exception as error:
            # Өлшеу қатесін көрсетіп, келесі циклде қайта өлшейміз.
            state = "ERROR"
            print("Өлшеу қатесі:", error)
            try:
                show_status(pixels, state)
            except Exception as led_error:
                print("Жарық индикациясының қатесі:", led_error)

        log_measurement(number, raw, filtered, baseline, threshold, source, state)
        time.sleep_ms(MONITOR_INTERVAL_MS)


if __name__ == "__main__":
    main()
