try:
    import urequests as requests
except ImportError:
    import requests

try:
    import ntptime
except ImportError:
    ntptime = None

try:
    import ssd1306
except ImportError:
    ssd1306 = None


# PIR қозғалысты, LDR жарық деңгейін өлшейді
PIR_PINS = [25, 33]         
LDR_PINS = [34]           
LDR_INVERT = False          

LAMP_TYPE = "gpio"          
LAMP_PIN = 26               
LAMP_ACTIVE_HIGH = True     
LAMP_PWM = False            
WS_COUNT = 8                

OLED_SDA = 21
OLED_SCL = 22
OLED_ADDR = 0x3C

WIFI_SSID = "YOUR_WIFI"
WIFI_PASS = "YOUR_PASSWORD"


API_URL = ""                
API_METHOD = "GET"          
API_KEY = ""                
API_KEY_HEADER = "X-API-Key"
API_KEY_PREFIX = ""        
API_TIMEOUT_S = 5
API_REFRESH_S = 60
THRESHOLD_UNITS = "percent"  


TB_ENABLED = False
TB_TOKEN = ""              
TB_EVERY_S = 10

TZ_OFFSET_H = 5


# Қосу мен өшіру шектері бөлек, сондықтан шам шек маңында жиі жыпылықтамайды
LOCAL_CFG = {
    "hold_time": 10,        
    "dark_threshold": 30,   
    "light_threshold": 45,  
    "brightness": 100,      
    "mode": "auto",         
}
MODES = ("auto", "always_on", "always_off")
FALLBACK_TO_LOCAL = True    

LOG_FILE = "log.txt"
LOG_MAX_BYTES = 20000
CALIB_FILE = "calib.json"
LOG_LDR_EVERY_S = 30        

cfg = dict(LOCAL_CFG)


def now_str():
    t = time.time()
    if time.localtime(t)[0] >= 2024:        
        y, mo, d, h, mi, s = time.localtime(t + TZ_OFFSET_H * 3600)[:6]
        return "%04d-%02d-%02d %02d:%02d:%02d" % (y, mo, d, h, mi, s)
    # Сағат бапталмаса, іске қосылғалы өткен секундты көрсетеміз
    return "T+%ds" % (time.ticks_ms() // 1000)


def log(event, info=""):
    line = "%s | %s | %s" % (now_str(), event, info)
    print(line)
    try:
        # Журнал көлемі шектен асса, оны .old файлына ауыстырамыз
        if LOG_FILE in os.listdir() and os.stat(LOG_FILE)[6] > LOG_MAX_BYTES:
            try:
                os.remove(LOG_FILE + ".old")
            except OSError:
                pass
            os.rename(LOG_FILE, LOG_FILE + ".old")
        with open(LOG_FILE, "a") as f:
            f.write(line + "\n")
    except Exception as e:
        print("log error:", e)


pirs = [Pin(p, Pin.IN) for p in PIR_PINS]

# Жарық датчиктерін аналог кіріске қосамыз
ldrs = []
for _p in LDR_PINS:
    _a = ADC(Pin(_p))
    _a.atten(ADC.ATTN_11DB)                
    ldrs.append(_a)

# Баптауға қарай шамды WS2812, PWM немесе GPIO арқылы басқарамыз
_ws = None
_gpio = None
_pwm = None
if LAMP_TYPE == "ws2812":
    import neopixel
    _ws = neopixel.NeoPixel(Pin(LAMP_PIN), WS_COUNT)
elif LAMP_PWM:
    from machine import PWM
    _pwm = PWM(Pin(LAMP_PIN), freq=1000, duty=0)
else:
    _gpio = Pin(LAMP_PIN, Pin.OUT)

oled = None
if ssd1306:
    try:
        _i2c = SoftI2C(scl=Pin(OLED_SCL), sda=Pin(OLED_SDA), freq=400000)
        oled = ssd1306.SSD1306_I2C(128, 64, _i2c, OLED_ADDR)
    except Exception as e:
        print("OLED не найден:", e)
        oled = None


def show(*lines):
    if not oled:
        return
    try:
        oled.fill(0)
        # Экранға алты жолға дейін, әр жолға 16 таңба шығарамыз
        for i, ln in enumerate(lines[:6]):
            oled.text(str(ln)[:16], 0, i * 10)
        oled.show()
    except Exception as e:
        print("OLED error:", e)


def lamp_set(on):
    level = cfg["brightness"] if on else 0
    if _ws is not None:
        v = int(255 * level / 100)
        color = (v, int(v * 0.8), int(v * 0.5))
        for i in range(WS_COUNT):
            _ws[i] = color
        _ws.write()
    elif _pwm is not None:
        duty = int(1023 * level / 100)
        _pwm.duty(duty if LAMP_ACTIVE_HIGH else 1023 - duty)
    else:
        _gpio.value(1 if (on == LAMP_ACTIVE_HIGH) else 0)


def read_raw():
    """Среднее по датчикам света (0..4095), с учётом инверсии."""
    total = 0
    n = 0
    # Бір өлшемге сүйенбей, әр датчикті 16 рет оқимыз
    for a in ldrs:
        for _ in range(16):
            total += a.read()
            n += 1
    raw = total / n
    return 4095 - raw if LDR_INVERT else raw


def motion():
    # Бір PIR іске қосылса, қозғалыс бар деп есептейміз
    for p in pirs:
        if p.value():
            return True
    return False


calib = {"dark": 300, "light": 3000}


def measure(seconds):
    end = time.ticks_add(time.ticks_ms(), seconds * 1000)
    s = 0
    n = 0
    while time.ticks_diff(end, time.ticks_ms()) > 0:
        s += read_raw()
        n += 1
        time.sleep_ms(50)
    return s / n


def raw_for_pct(p):
    return int(calib["dark"] + (calib["light"] - calib["dark"]) * p / 100)


def pct_for_raw(r):
    # Қараңғыдағы өлшем — 0%, жарықтағы өлшем — 100%
    span = calib["light"] - calib["dark"]
    if span <= 0:
        return 100
    return max(0, min(100, int((r - calib["dark"]) * 100 / span)))


def log_calib_table():
    log("CALIB_TABLE", "bright=%d dark=%d | ON thr=%d (<%d%%) OFF thr=%d (>%d%%)" % (
        calib["light"], calib["dark"],
        raw_for_pct(cfg["dark_threshold"]), cfg["dark_threshold"],
        raw_for_pct(cfg["light_threshold"]), cfg["light_threshold"]))


def calibrate():
    # Датчикті алдымен жауып, сосын ашып өлшейміз
    log("CALIB_START")
    for i in range(3, 0, -1):
        show("CALIBRATION", "Cover the light", "sensor with hand", "in %d..." % i)
        time.sleep(1)
    show("Measuring DARK", "hold...")
    dark = measure(3)
    for i in range(3, 0, -1):
        show("CALIBRATION", "Uncover sensor", "(normal light)", "in %d..." % i)
        time.sleep(1)
    show("Measuring LIGHT", "hold...")
    light = measure(3)
    # Айырмасы 100-ден аз болса, жаңа өлшемдерді сақтамаймыз
    if light - dark < 100:
        log("CALIB_FAIL", "dark=%d light=%d (разница мала; проверь датчик/LDR_INVERT)" % (dark, light))
        return False
    calib["dark"], calib["light"] = dark, light
    try:
        with open(CALIB_FILE, "w") as f:
            json.dump(calib, f)
    except Exception as e:
        print("calib save error:", e)
    log("CALIB_OK", "dark=%d light=%d" % (dark, light))
    return True


def load_calib():
    try:
        with open(CALIB_FILE) as f:
            d = json.load(f)
        calib["dark"], calib["light"] = d["dark"], d["light"]
        return True
    except Exception:
        return False


def light_percent():
    return pct_for_raw(read_raw())


wlan = network.WLAN(network.STA_IF)


def wifi_connect(timeout=15):
    wlan.active(True)
    if wlan.isconnected():
        return True
    try:
        wlan.connect(WIFI_SSID, WIFI_PASS)
    except Exception as e:
        log("WIFI_FAIL", str(e))
        return False
    # Wi-Fi қосылғанша немесе күту уақыты біткенше тексереміз
    t0 = time.ticks_ms()
    while not wlan.isconnected():
        if time.ticks_diff(time.ticks_ms(), t0) > timeout * 1000:
            log("WIFI_FAIL", "timeout")
            return False
        time.sleep_ms(200)
    log("WIFI_OK", wlan.ifconfig()[0])
    return True


def sync_time():
    if ntptime and wlan.isconnected():
        try:
            ntptime.settime()
            log("NTP_OK")
        except Exception as e:
            log("NTP_FAIL", str(e))


def _find(d, keys):
    for k in keys:
        if k in d:
            return d[k]
    return None


def _to_pct(v):
    """Порог из API -> проценты (если API присылает «сырые» значения LDR)."""
    if THRESHOLD_UNITS == "raw":
        return pct_for_raw(v)
    return v


def parse_params(data):
    """Возвращает (params, error). params — только проверенные значения."""
    if not isinstance(data, dict):
        return None, "ответ не JSON-объект"
    # Кейде жуйе жауаптың ішкі бөлімінде келеді
    for k in ("data", "config", "params", "settings", "recommendation"):
        if isinstance(data.get(k), dict):
            data = data[k]
            break
    params = {}

    # Келген мәндерді санға айналдырып тиісті аралықта тұрғанын тексереміз
    v = _find(data, ("hold_time", "hold_seconds", "hold", "timeout", "delay"))
    if v is not None:
        try:
            v = int(float(v))
        except (TypeError, ValueError):
            return None, "hold_time не число"
        if not 1 <= v <= 3600:
            return None, "hold_time вне диапазона 1..3600"
        params["hold_time"] = v

    v = _find(data, ("dark_threshold", "on_threshold", "threshold", "light_threshold_on"))
    if v is not None:
        try:
            v = int(_to_pct(float(v)))
        except (TypeError, ValueError):
            return None, "dark_threshold не число"
        if not 1 <= v <= 99:
            return None, "dark_threshold вне диапазона"
        params["dark_threshold"] = v

    v = _find(data, ("light_threshold", "off_threshold", "light_threshold_off"))
    if v is not None:
        try:
            v = int(_to_pct(float(v)))
        except (TypeError, ValueError):
            return None, "light_threshold не число"
        if not 1 <= v <= 99:
            return None, "light_threshold вне диапазона"
        params["light_threshold"] = v

    v = _find(data, ("brightness", "level", "intensity"))
    if v is not None:
        try:
            v = int(float(v))
        except (TypeError, ValueError):
            return None, "brightness не число"
        if not 0 <= v <= 100:
            return None, "brightness вне диапазона 0..100"
        params["brightness"] = v

    v = _find(data, ("mode", "lighting_mode", "profile"))
    if v is not None:
        v = str(v).lower()
        if v not in MODES:
            return None, "неизвестный режим '%s'" % v
        params["mode"] = v

    if not params:
        return None, "нужных параметров в ответе нет"

    # Өшіру шегі қосу шегінен жоғары болуы керек
    on_t = params.get("dark_threshold", cfg["dark_threshold"])
    off_t = params.get("light_threshold", cfg["light_threshold"])
    if off_t <= on_t:
        return None, "порог выключения должен быть выше порога включения"
    return params, None


def use_local(reason):
    if FALLBACK_TO_LOCAL and cfg != LOCAL_CFG:
        cfg.clear()
        cfg.update(LOCAL_CFG)
        log("API_FALLBACK", "локальные параметры (%s)" % reason)
    else:
        log("API_FALLBACK", reason)


def api_fetch(state=None):
    if not API_URL:
        return
    if not wlan.isconnected() and not wifi_connect(8):
        use_local("нет Wi-Fi")
        return
    r = None
    try:
        headers = {}
        if API_KEY:
            headers[API_KEY_HEADER] = API_KEY_PREFIX + API_KEY
        # POST сұрауымен құрылғының қазіргі күйін де жібереміз
        if API_METHOD == "POST":
            headers["Content-Type"] = "application/json"
            body = json.dumps(state or {})
            try:
                r = requests.post(API_URL, data=body, headers=headers, timeout=API_TIMEOUT_S)
            except TypeError:
                r = requests.post(API_URL, data=body, headers=headers)
        else:
            try:
                r = requests.get(API_URL, headers=headers, timeout=API_TIMEOUT_S)
            except TypeError:
                r = requests.get(API_URL, headers=headers)
        if r.status_code != 200:
            use_local("HTTP %d" % r.status_code)
            return
        params, err = parse_params(r.json())
        if err:
            log("API_INVALID", err)
            use_local(err)
            return
        cfg.clear()
        cfg.update(LOCAL_CFG)                 
        cfg.update(params)
        log("API_OK", "hold=%ds dark<%d%% light>%d%% bright=%d%% mode=%s" % (
            cfg["hold_time"], cfg["dark_threshold"], cfg["light_threshold"],
            cfg["brightness"], cfg["mode"]))
        log_calib_table()
    except Exception as e:
        log("API_FAIL", str(e))
        use_local("ошибка сети")
    finally:
        if r:
            try:
                r.close()
            except Exception:
                pass


_tb = {"next": 0, "fails": 0}


def tb_send(raw, pct, lamp, mov, now):
    # Жіберу уақыты келсе ғана жарық, шам және қозғалыс деректерін жібереміз.
    if not TB_ENABLED or not TB_TOKEN or time.ticks_diff(now, _tb["next"]) < 0:
        return
    if not wlan.isconnected():
        _tb["next"] = time.ticks_add(now, 15000)
        return
    r = None
    try:
        url = "http://thingsboard.cloud/api/v1/%s/telemetry" % TB_TOKEN
        body = json.dumps({"ldr": int(raw), "light_pct": pct, "led1": bool(lamp), "motion": bool(mov)})
        headers = {"Content-Type": "application/json"}
        try:
            r = requests.post(url, data=body, headers=headers, timeout=3)
        except TypeError:
            r = requests.post(url, data=body, headers=headers)
        _tb["fails"] = 0 if r.status_code == 200 else _tb["fails"] + 1
        _tb["next"] = time.ticks_add(now, TB_EVERY_S * 1000)
    except Exception as e:
        _tb["fails"] += 1
        if _tb["fails"] == 1:
            log("TB_FAIL", str(e))
        _tb["next"] = time.ticks_add(now, 60000 if _tb["fails"] >= 3 else TB_EVERY_S * 1000)
    finally:
        if r:
            try:
                r.close()
            except Exception:
                pass


st = {"lamp": False, "off_at": 0, "offset": 0, "dark": False}


def lamp_on(now, pct, reason):
    lamp_set(True)
    st["lamp"] = True
    st["off_at"] = time.ticks_add(now, cfg["hold_time"] * 1000)

    time.sleep_ms(300)
    st["offset"] = max(0, light_percent() - pct)
    log("LAMP", "ON (%s) HOLD TIME: %d sec, self-light %d%%" % (reason, cfg["hold_time"], st["offset"]))


def lamp_off(reason):
    lamp_set(False)
    st["lamp"] = False
    st["offset"] = 0
    log("LAMP", "OFF (%s)" % reason)


def step(now, pct, mov):
    """Один шаг алгоритма: pct — освещённость %, mov — есть ли движение."""
    mode = cfg["mode"]

    # Тұрақты режимде датчиктердің көрсеткіші шамның күйін өзгертпейді.
    if mode == "always_off":
        if st["lamp"]:
            lamp_off("mode always_off")
        return
    if mode == "always_on":
        if not st["lamp"]:
            lamp_on(now, pct, "mode always_on")
        return

    # --- auto ---
    eff = pct - st["offset"] if st["lamp"] else pct        
    if pct < cfg["dark_threshold"]:
        st["dark"] = True
    elif eff > cfg["light_threshold"]:
        st["dark"] = False

    # Қараңғыда қозғалыс болса, шам жанады. Қозғалыс жалғасса, таймер жаңарады.
    if st["lamp"]:
        if not st["dark"]:
            lamp_off("became light")                       
        elif mov:
            st["off_at"] = time.ticks_add(now, cfg["hold_time"] * 1000)   
        elif time.ticks_diff(now, st["off_at"]) >= 0:
            lamp_off("no motion for %d sec" % cfg["hold_time"])
    else:
        if mov and st["dark"]:
            lamp_on(now, pct, "dark + motion")

# ---------------------------------------------------------------------
#  MAIN
# ---------------------------------------------------------------------
def main():
    lamp_set(False)
    log("SYSTEM STARTED")
    show("A2 Induction", "lamp v2", "Starting...")

    show("Wi-Fi...", WIFI_SSID)
    if wifi_connect():
        sync_time()

    # Сақталған өлшемдер болмаса немесе BOOT басылса, қайта калибрлейміз
    boot_btn = Pin(0, Pin.IN, Pin.PULL_UP)
    if not load_calib() or boot_btn.value() == 0:
        calibrate()
    else:
        log("CALIB_LOADED", "dark=%d light=%d" % (calib["dark"], calib["light"]))
    log_calib_table()

    api_fetch({"device": "esp32-a2", "ldr": int(read_raw()), "light_pct": light_percent(), "motion": motion()})
    last_api = time.ticks_ms()

    show("PIR warm-up...")
    time.sleep(3)
    log("SYSTEM READY")

    last_mov = False
    last_ldr_log = 0
    last_oled = 0
    last_status = None
    bad_range = 0
    bad_warned = False

    # Әр айналымда датчиктерді оқып, шамның күйін жаңартамыз
    while True:
        now = time.ticks_ms()
        raw = read_raw()
        pct = pct_for_raw(raw)
        mov = motion()

        
        if raw <= 5 or raw >= 4090:
            bad_range += 1
            if bad_range > 20 and not bad_warned:
                bad_warned = True
                log("SENSOR_ERROR", "LDR raw=%d (проверь провод/пин/питание)" % raw)
        else:
            bad_range = 0
            bad_warned = False

        if mov != last_mov:
            log("PIR", "MOTION DETECTED" if mov else "NO MOTION")
            last_mov = mov

        step(now, pct, mov)

        # Жарық күйі өзгерсе немесе уақыт аралығы өтсе, журналға жазамыз
        status = "DARK" if st["dark"] else "LIGHT"
        if status != last_status or time.ticks_diff(now, last_ldr_log) > LOG_LDR_EVERY_S * 1000:
            log("LDR", "%d (%d%%) STATUS: %s" % (raw, pct, status))
            last_status = status
            last_ldr_log = now

        if API_URL and time.ticks_diff(now, last_api) > API_REFRESH_S * 1000:
            last_api = now
            api_fetch({"device": "esp32-a2", "ldr": int(raw), "light_pct": pct, "motion": mov})
            if st["lamp"]:
                lamp_set(True)                              # применить новую яркость

        tb_send(raw, pct, st["lamp"], mov, now)

        # Экранды шамамен жарты секунд сайын жаңартамыз
        if time.ticks_diff(now, last_oled) > 500:
            last_oled = now
            left = max(0, time.ticks_diff(st["off_at"], now) // 1000) if st["lamp"] else 0
            show(
                "LAMP: " + ("ON" if st["lamp"] else "OFF"),
                "Light:%d%% %s" % (pct, status),
                "On<%d Off>%d" % (cfg["dark_threshold"], cfg["light_threshold"]),
                "Motion: " + ("YES" if mov else "NO"),
                "Hold:%ds left %d" % (cfg["hold_time"], left),
                "%s WiFi:%s" % (cfg["mode"][:8], "OK" if wlan.isconnected() else "--"),
            )

        time.sleep_ms(50)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        lamp_set(False)
        log("STOP", "KeyboardInterrupt")
    except Exception as e:
        lamp_set(False)
        log("CRASH", repr(e))
        raise

